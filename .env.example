# Anthropic API key. Required for the agentic /api/chat tool-use loop; without it
# the API falls back to plain semantic search (clearly labeled "degraded mode").
ANTHROPIC_API_KEY=

# Postgres connection string for the pgvector backend (e.g. a Neon connection
# string in production). Leave unset for local dev: the ingestion pipeline and
# MCP server fall back to a local SQLite vector store (ingest/aircfo_demo.sqlite3).
DATABASE_URL=
